  "asset_refresh_commands": [
    "npm run vibeproof:assets",
    "npm run vibeproof:capture",
    "npm run vibeproof:visuals",
    "$env:VIBEPROOF_URL='https://YOUR-VERCEL-PREVIEW-URL'; npm run vibeproof:capture; Remove-Item Env:VIBEPROOF_URL"
